{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "victorypvi-sync",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncRoom"]
    }
  ]
}
